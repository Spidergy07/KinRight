# Backend-only secrets. Do not expose API keys with VITE_ prefixes.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Frontend API URL. During LAN testing, the app rewrites localhost to the phone's current host.
VITE_API_URL=http://localhost:3000

# Images are uploaded to Cloudinary temporarily, then deleted after Gemini analysis.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=streetfood-ai/uploads

# Gemini vision / OCR / Thai order generation.
# Use these on the backend only. Rotate for failover, not to bypass Google quotas.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Optional safety limits for small demos.
MAX_UPLOAD_MB=10
MAX_GEMINI_RETRIES=4
