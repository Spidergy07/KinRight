# Backend-only secrets. Do not expose API keys with VITE_ prefixes.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Frontend API URL for local dev. On same-project Vercel deploys, leave this unset in Vercel.
# During LAN testing, the app rewrites localhost to the phone's current host.
VITE_API_URL=http://localhost:3000

# Images are uploaded to Cloudinary temporarily, then deleted after Gemini analysis.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=kinright/uploads

# Gemini vision / OCR / Thai order generation.
# Use these on the backend only. Rotate for failover, not to bypass Google quotas.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Optional safety limits for small demos. Keep this <= 5 on Vercel Functions.
MAX_UPLOAD_MB=4
MAX_GEMINI_RETRIES=5
